# PROVENTURE MARKETPLACE - Environment Variables Template
# Copy this file to .env.local and update values

# Application
NEXT_PUBLIC_APP_NAME="ProVenture Marketplace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# Neon PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/proventure_db?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/proventure_db?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_SECRET="proventure-super-secret-jwt-session-token-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (Media Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="proventure-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
CLOUDINARY_UPLOAD_PRESET="proventure_marketplace_uploads"

# Razorpay (Payment Gateway)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId1234"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecret5678"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecret9999"

# Marketplace Platform Commission (%)
MARKETPLACE_COMMISSION_PERCENT=10

# Mock Data / Offline Mode Flag
# When true or when DATABASE_URL is not connected, the app uses seamless in-memory fallback
NEXT_PUBLIC_USE_MOCK_FALLBACK=true
